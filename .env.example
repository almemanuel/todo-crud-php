CI_ENVIRONMENT=development
APP_BASE_URL='http://localhost:8080/'

DB_HOST=db
DB_NAME=nome_base
DB_USER=seu_usuario
DB_PASS=sua_senha
DB_PORT=5432

database.default.charset = utf8
database.default.DBCollat = utf8
database.default.hostname = ${DB_HOST}
